<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="j2commerce" method="upgrade">
    <name>PLG_J2COMMERCE_PAYMENT_ORBONI</name>
    <author>Orboni</author>
    <authorEmail>support@orboni.com</authorEmail>
    <authorUrl>https://orboni.com</authorUrl>
    <creationDate>2026-11-23</creationDate>
    <copyright>Copyright (C) 2026 Orboni</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE</license>
    <version>1.0.1</version>
    <description>PLG_J2COMMERCE_PAYMENT_ORBONI_XML_DESCRIPTION</description>
    <namespace path="src">Orboni\Plugin\J2commerce\PaymentOrboni</namespace>
    <scriptfile>script.php</scriptfile>

    <files>
        <folder plugin="payment_orboni">services</folder>
        <folder>language</folder>
        <folder>sql</folder>
        <folder>src</folder>
        <folder>tmpl</folder>
        <filename>LICENSE</filename>
        <filename>README.md</filename>
        <filename>script.php</filename>
    </files>

    <languages folder="language">
        <language tag="en-GB">en-GB/plg_j2commerce_payment_orboni.ini</language>
        <language tag="en-GB">en-GB/plg_j2commerce_payment_orboni.sys.ini</language>
    </languages>

    <install>
        <sql>
            <file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
        </sql>
    </install>
    <uninstall>
        <sql>
            <file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
        </sql>
    </uninstall>
    <update>
        <schemas>
            <schemapath type="mysql">sql/updates/mysql</schemapath>
        </schemas>
    </update>

    <config>
        <fields name="params">
            <fieldset name="basic" label="PLG_J2COMMERCE_PAYMENT_ORBONI_FIELDSET_ORBONI" addfieldprefix="Orboni\Plugin\J2commerce\PaymentOrboni\Field">
                <field name="secret_key" type="Secret" hint="sk_live_…"
                    label="PLG_J2COMMERCE_PAYMENT_ORBONI_SECRET_KEY" description="PLG_J2COMMERCE_PAYMENT_ORBONI_SECRET_KEY_DESC"/>
                <field name="webhook_secret" type="Secret" hint="whsec_…"
                    label="PLG_J2COMMERCE_PAYMENT_ORBONI_WEBHOOK_SECRET" description="PLG_J2COMMERCE_PAYMENT_ORBONI_WEBHOOK_SECRET_DESC"/>
                <field name="addresses" type="Addresses" label="PLG_J2COMMERCE_PAYMENT_ORBONI_ADDRESSES" filter="unset"/>
                <field name="paid_status" type="Orderstatus" default=""
                    label="PLG_J2COMMERCE_PAYMENT_ORBONI_PAID_STATUS" description="PLG_J2COMMERCE_PAYMENT_ORBONI_PAID_STATUS_DESC"
                    addfieldprefix="J2Commerce\Component\J2commerce\Administrator\Field" layout="joomla.form.field.list-fancy-select">
                    <option value="">PLG_J2COMMERCE_PAYMENT_ORBONI_STATUS_AUTO_PAID</option>
                </field>
                <field name="waiting_status" type="Orderstatus" default=""
                    label="PLG_J2COMMERCE_PAYMENT_ORBONI_WAITING_STATUS" description="PLG_J2COMMERCE_PAYMENT_ORBONI_WAITING_STATUS_DESC"
                    addfieldprefix="J2Commerce\Component\J2commerce\Administrator\Field" layout="joomla.form.field.list-fancy-select">
                    <option value="">PLG_J2COMMERCE_PAYMENT_ORBONI_STATUS_AUTO_WAITING</option>
                </field>
                <field name="debug" type="radio" layout="joomla.form.field.radio.switcher" default="0"
                    label="PLG_J2COMMERCE_PAYMENT_ORBONI_DEBUG" description="PLG_J2COMMERCE_PAYMENT_ORBONI_DEBUG_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
            </fieldset>
            <fieldset name="checkout" label="PLG_J2COMMERCE_PAYMENT_ORBONI_FIELDSET_CHECKOUT">
                <field name="display_name" type="text" default="PLG_J2COMMERCE_PAYMENT_ORBONI_DEFAULT_NAME"
                    label="PLG_J2COMMERCE_PAYMENT_ORBONI_DISPLAY_NAME"/>
                <field name="display_image" type="media" label="PLG_J2COMMERCE_PAYMENT_ORBONI_DISPLAY_IMAGE"/>
                <field name="button_text" type="text" default="PLG_J2COMMERCE_PAYMENT_ORBONI_BUTTON"
                    label="PLG_J2COMMERCE_PAYMENT_ORBONI_BUTTON_TEXT"/>
                <field name="onbeforepayment" type="textarea" filter="safehtml" rows="3" default=""
                    label="PLG_J2COMMERCE_PAYMENT_ORBONI_ON_BEFORE_PAYMENT"/>
                <field name="geozone_id" type="Geozone" default=""
                    label="PLG_J2COMMERCE_PAYMENT_ORBONI_GEOZONE" description="PLG_J2COMMERCE_PAYMENT_ORBONI_GEOZONE_DESC"
                    addfieldprefix="J2Commerce\Component\J2commerce\Administrator\Field" layout="joomla.form.field.list-fancy-select"/>
            </fieldset>
        </fields>
    </config>

    <updateservers>
        <server type="extension" priority="1" name="Orboni for J2Commerce">https://raw.githubusercontent.com/orboni/j2commerce-payment/main/update.xml</server>
    </updateservers>
</extension>
